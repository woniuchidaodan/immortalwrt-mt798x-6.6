# ========== quickstart 整套 ==========
CONFIG_PACKAGE_luci-app-quickstart=y
CONFIG_PACKAGE_luci-i18n-quickstart-zh-cn=y
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-lib-taskd=y
CONFIG_PACKAGE_luci-lib-xterm=y
CONFIG_PACKAGE_taskd=y

# ========== 明确禁用的包 ==========
# CONFIG_PACKAGE_bash is not set
# CONFIG_PACKAGE_htop is not set
# CONFIG_PACKAGE_nano is not set
# CONFIG_PACKAGE_openssh-sftp-server is not set
# CONFIG_PACKAGE_curl is not set
# CONFIG_PACKAGE_wget-ssl is not set
# CONFIG_PACKAGE_luci-app-advancedplus is not set
# CONFIG_PACKAGE_luci-app-syscontrol is not set
# CONFIG_PACKAGE_mdadm is not set
# CONFIG_PACKAGE_smartd is not set
# CONFIG_PACKAGE_smartmontools is not set
# CONFIG_PACKAGE_shadow-utils is not set
# CONFIG_PACKAGE_shadow is not set

# ========== ZRAM ==========
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-lib-zstd=y

# ========== 网络加速 ==========
CONFIG_PACKAGE_kmod-tcp-bbr=y

# ========== 代理 / 过滤依赖 ==========
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_nftables-json=y

# ========== LuCI 基础 ==========
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-lib-fs=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y

# ========== Argon 主题 ==========
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# ========== UA3F ==========
CONFIG_PACKAGE_ua3f=y
# 若 luci-app-ua3f 存在则保留，否则删掉
CONFIG_PACKAGE_luci-app-ua3f=y

# ========== OAF ==========
# 以下三个包名需要核对，不存在的删掉
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_PACKAGE_open-app-filter=y
# CONFIG_PACKAGE_oaf=y

# ========== 分区解锁 ==========
CONFIG_PACKAGE_kmod-mtd-rw=y

# ========== opkg（只在源码用 opkg 时保留） ==========
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_libopkg=y
CONFIG_PACKAGE_opkg-meta-essential=y
